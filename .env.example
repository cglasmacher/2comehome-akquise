APP_NAME="2 COME HOME Akquise"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://akquise.2comehome.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=2comehome_akquise
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_RETRY_AFTER=360
MAIL_MAILER=log

# Optional: Nominatim-kompatibler, für diesen Einsatz freigegebener Geocoder.
# Ohne Geocoder sind Hilden, 40721, Düsseldorf, Köln oder manuelle Koordinaten verfügbar.
GEOCODER_URL=

# Accounts werden ausschließlich serverseitig gespeichert.
# Login allein aktiviert keinen Portalabruf. Freigegebene API/Feed-Anbindung ergänzen.
